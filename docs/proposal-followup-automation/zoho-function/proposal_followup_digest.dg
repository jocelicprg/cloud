void schedule.proposal_followup_digest_v2()
{
    /*
     * CPR Group - Proposal follow-up digest
     * Zoho CRM scheduled function (Deluge)
     *
     * Created from Setup -> Automation -> Schedules -> New Schedule -> Create a
     * New Function, which puts it in the SCHEDULE category. That category returns
     * void, so this function must not return a value. The same code pasted into
     * Developer Space -> Functions needs the standalone signature instead:
     *     string standalone.proposal_followup_digest()
     * plus "return summary;" at the end. Install and test steps are in README.md.
     *
     * Each weekday morning this emails every consultant a digest of the proposals
     * they need to chase, with the action for that business day. It reads from CRM
     * and writes nothing. It never contacts a client.
     *
     * THIS IS THE LIVE CONFIGURATION. Dry runs on 10 September 2026 confirmed the
     * two things that cannot be verified outside CRM - date parsing and the
     * workDaysBetween boundary - and a send test proved the mail path. To go back
     * to logging without sending, set SEND_EMAILS to false and DEBUG_DATES to true.
     */

    // ---------------------------------------------------------------------------
    // CONFIG
    // ---------------------------------------------------------------------------

    // Proposals sent before this date never produce a reminder. This is the only
    // thing keeping the ~62 proposals already at Formal Quote Sent quiet.
    // Written the way Deluge reads dates most reliably: dd-MMM-yyyy.
    GO_LIVE = '10-Sep-2026'.toDate();

    // false = send nothing, just log. Use this until the first run looks right.
    SEND_EMAILS = true;

    // Set true for one run to log the raw and parsed dates for every deal.
    // Useful the first time and when something looks off. Noisy otherwise.
    DEBUG_DATES = false;

    // NOTE ON EMAIL ADDRESSES
    // Deluge validates the sendmail address fields when the script is saved,
    // so they cannot be set from variables up here. They are literals in the
    // sendmail block near the bottom of this function:
    //   from - zoho.loginuserid, which is whoever owns the schedule
    //   cc   - nathan.butcher@cprgroup.com.au, on day 4 escalations only
    // Change them there, not here.

    // Skipped as non-working days along with weekends. Something the Zapier build
    // could not do. Keep this topped up each year.
    HOLIDAYS = {'25-Dec-2026','28-Dec-2026','01-Jan-2027','26-Jan-2027','26-Mar-2027','29-Mar-2027','25-Apr-2027','03-May-2027'};

    CRM_DEAL_URL = 'https://crm.zoho.com.au/crm/org691602767/tab/Potentials/';

    // ---------------------------------------------------------------------------
    // GATHER
    // ---------------------------------------------------------------------------

    today = zoho.currentdate;

    // Up to 200 per page, comfortably more than the ~62 at this stage.
    deals = zoho.crm.searchRecords("Deals", "(Stage:equals:Formal Quote Sent)", 1, 200);

    byConsultant = Map();
    examined = 0;
    skipped = 0;

    for each deal in deals
    {
        // A deal map always has an id. Anything without one is an error response
        // rather than a record, so it is left alone.
        if(deal.get("id") != null)
        {
            examined = examined + 1;

            dealId = deal.get("id");
            dealName = ifnull(deal.get("Deal_Name"), "Untitled deal");

            ownerEmail = "";
            ownerName = "";
            ownerMap = deal.get("Owner");
            if(ownerMap != null)
            {
                ownerEmail = ifnull(ownerMap.get("email"), "");
                ownerName = ifnull(ownerMap.get("name"), "");
            }

            org = "client not recorded";
            accountMap = deal.get("Account_Name");
            if(accountMap != null)
            {
                org = ifnull(accountMap.get("name"), org);
            }

            contact = "";
            contactMap = deal.get("Contact_Name");
            if(contactMap != null)
            {
                contact = ifnull(contactMap.get("name"), "");
            }

            sentRaw = ifnull(deal.get("Date_Proposal_Sent"), "");
            lastRaw = ifnull(deal.get("Last_Activity_Time"), "");
            createdRaw = ifnull(deal.get("Created_Time"), "");

            // The owner field is the only thing deciding where a digest goes, and
            // the digest carries client names and deal values. The CRM has users
            // on outside domains (@remap.ai, @screen-magic.com), disabled today
            // but reactivatable, so an address is checked before it is trusted
            // rather than after.
            if(ownerEmail == "")
            {
                info "SKIP no owner email - " + org + " - " + CRM_DEAL_URL + dealId;
                skipped = skipped + 1;
            }
            else if(ownerEmail.endsWith("@cprgroup.com.au") == false)
            {
                info "SKIP owner outside cprgroup.com.au (" + ownerEmail + ") - " + org + " - " + CRM_DEAL_URL + dealId;
                skipped = skipped + 1;
            }
            else
            {
                // Start this consultant's bucket the first time they appear.
                if(byConsultant.containKey(ownerEmail) == false)
                {
                    firstName = ownerName;
                    if(ownerName.contains(" "))
                    {
                        firstName = ownerName.getPrefix(" ");
                    }
                    fresh = Map();
                    fresh.put("first_name", firstName);
                    fresh.put("due", List());
                    fresh.put("undated", List());
                    byConsultant.put(ownerEmail, fresh);
                }
                bucket = byConsultant.get(ownerEmail);

                if(sentRaw == "")
                {
                    // A proposal with no date cannot be counted, and cannot be
                    // compared against GO_LIVE either. Without a second guard
                    // the whole undated backlog lands in someone's inbox on the
                    // first morning: the first dry run would have sent Chris a
                    // list of eight proposals, several from 2025.
                    //
                    // So fall back to when the deal was created. A proposal
                    // raised since go-live and missing its date is worth
                    // chasing; one raised last year is backlog, and belongs in
                    // the regular deal review instead.
                    //
                    // Deluge will not chain .add() onto a .get(), so the list
                    // is pulled out, changed, and put back. Same below for "due".
                    includeUndated = false;
                    if(createdRaw != "")
                    {
                        createdText = createdRaw.subString(0,10);
                        createdDate = createdText.toDate();
                        if(createdDate >= GO_LIVE)
                        {
                            includeUndated = true;
                        }
                    }

                    if(includeUndated)
                    {
                        undatedList = bucket.get("undated");
                        undatedList.add("<li style='margin-bottom:4px;'><b>" + org + "</b> &nbsp;&middot;&nbsp; " + dealName + " &nbsp;&middot;&nbsp; <a href='" + CRM_DEAL_URL + dealId + "'>open in CRM</a></li>");
                        bucket.put("undated", undatedList);
                    }
                    else
                    {
                        skipped = skipped + 1;
                        if(DEBUG_DATES)
                        {
                            info "UNDATED skipped as pre go-live - " + org + " | created=" + createdRaw;
                        }
                    }
                }
                else
                {
                    // Zoho returns a date field as yyyy-MM-dd and a datetime as an
                    // ISO string. Taking the first 10 characters gives a plain date
                    // in both cases.
                    //
                    // IF THE FIRST RUN ERRORS HERE, try this instead:
                    //     sentDate = sentRaw.subString(0,10).toDate("yyyy-MM-dd");
                    sentText = sentRaw.subString(0,10);
                    sentDate = sentText.toDate();

                    // Day 1 is the day the proposal was sent, so the next working
                    // day is Day 2.
                    //
                    // IF EVERY DEAL IS ONE DAY OUT, adjust the + 1 here.
                    day = sentDate.workDaysBetween(today, {"Saturday","Sunday"}, HOLIDAYS) + 1;

                    if(DEBUG_DATES)
                    {
                        info "DATES " + org + " | raw=" + sentRaw + " | parsed=" + sentDate + " | today=" + today + " | day=" + day;
                    }

                    inWindow = true;
                    if(sentDate < GO_LIVE)
                    {
                        inWindow = false;
                    }
                    if(sentDate > today)
                    {
                        inWindow = false;
                    }
                    if(day < 2 || day > 4)
                    {
                        inWindow = false;
                    }

                    if(inWindow == false)
                    {
                        skipped = skipped + 1;
                    }
                    else
                    {
                        // Activity on a later day than the proposal went out counts
                        // as a follow-up. Same-day activity is not counted, because
                        // moving the deal into the stage updates Last_Activity_Time
                        // by itself.
                        followedUp = false;
                        if(lastRaw != "")
                        {
                            lastText = lastRaw.subString(0,10);
                            lastDate = lastText.toDate();
                            if(lastDate > sentDate)
                            {
                                followedUp = true;
                            }
                        }

                        // Days 2 and 3 are the plan for the day and go out
                        // regardless. Day 4 is the escalation, so it is suppressed
                        // as soon as anything is recorded.
                        if(day == 4 && followedUp)
                        {
                            skipped = skipped + 1;
                        }
                        else
                        {
                            action = "Nothing has been recorded since the proposal went out. Follow up today, or update the deal if you have already been in touch.";
                            if(day == 2)
                            {
                                action = "Send them a short, personal text today to check it arrived.";
                            }
                            if(day == 3)
                            {
                                action = "Give them a call today. If you do not get through, leave a voicemail where that suits and send a short email straight afterwards.";
                            }

                            who = contact;
                            if(contact == "")
                            {
                                who = "no contact linked to this deal";
                            }

                            // Deluge has no dependable number formatter here, and a
                            // runtime error in an unattended 8am run costs the whole
                            // digest, so the separator is done with string surgery on
                            // functions that cannot fail: subString and length.
                            amountText = "value not recorded";
                            if(deal.get("Amount") != null)
                            {
                                if(deal.get("Amount") > 0)
                                {
                                    digits = deal.get("Amount").toString();
                                    if(digits.contains("."))
                                    {
                                        digits = digits.getPrefix(".");
                                    }
                                    n = digits.length();
                                    grouped = digits;
                                    if(n > 6)
                                    {
                                        grouped = digits.subString(0, n - 6) + "," + digits.subString(n - 6, n - 3) + "," + digits.subString(n - 3, n);
                                    }
                                    else if(n > 3)
                                    {
                                        grouped = digits.subString(0, n - 3) + "," + digits.subString(n - 3, n);
                                    }
                                    amountText = "$" + grouped;
                                }
                            }

                            // Zoho CRM sends this as HTML, and Deluge does not turn
                            // "\n" into a line break - the first live digest printed
                            // the two characters instead. So every break is a tag.
                            edge = "#d0d0d0";
                            if(day == 4)
                            {
                                edge = "#c8102e";
                            }
                            block = "<div style='margin:0 0 18px;padding:2px 0 2px 12px;border-left:3px solid " + edge + ";'>";
                            block = block + "<div style='font-weight:bold;font-size:15px;'>" + org + "</div>";
                            block = block + "<div style='color:#666;font-size:13px;margin:2px 0 8px;'>" + dealName + " &nbsp;&middot;&nbsp; " + amountText + " &nbsp;&middot;&nbsp; sent " + sentDate.toString("d MMMM yyyy") + " &nbsp;&middot;&nbsp; " + who + "</div>";
                            block = block + "<div><b>Day " + day + ":</b> " + action + "</div>";
                            block = block + "<div style='margin-top:8px;font-size:13px;'><a href='" + CRM_DEAL_URL + dealId + "'>Open this deal in CRM</a></div>";
                            block = block + "</div>";

                            entry = Map();
                            entry.put("day", day);
                            entry.put("text", block);
                            dueSoFar = bucket.get("due");
                            dueSoFar.add(entry);
                            bucket.put("due", dueSoFar);
                        }
                    }
                }
                byConsultant.put(ownerEmail, bucket);
            }
        }
    }

    // ---------------------------------------------------------------------------
    // ONE DIGEST PER CONSULTANT
    // ---------------------------------------------------------------------------

    sentCount = 0;

    for each addr in byConsultant.keys()
    {
        bucket = byConsultant.get(addr);
        dueList = bucket.get("due");
        undatedList = bucket.get("undated");

        if(dueList.size() > 0 || undatedList.size() > 0)
        {
            escalating = false;

            // Built as one HTML string rather than a list of lines. Deluge does
            // not turn "\n" into a line break and Zoho sends this as HTML in any
            // case, so the tags carry the layout. Styles are inline because Gmail
            // discards a <style> block.
            body = "<div style='font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#222222;max-width:640px;'>";
            body = body + "<p style='margin:0 0 14px;'>Hi " + bucket.get("first_name") + ",</p>";

            if(dueList.size() > 0)
            {
                if(dueList.size() == 1)
                {
                    body = body + "<p style='margin:0 0 16px;'>One proposal needs a follow-up today.</p>";
                }
                else
                {
                    body = body + "<p style='margin:0 0 16px;'>" + dueList.size() + " proposals need a follow-up today.</p>";
                }
                for each item in dueList
                {
                    body = body + item.get("text");
                    if(item.get("day") == 4)
                    {
                        escalating = true;
                    }
                }

                // This paragraph used to promise that logging a follow-up stopped
                // the reminders. It does not. Days 2 and 3 go out either way,
                // because CRM cannot tell whether a text message was sent. Only
                // the Day 4 escalation is suppressed by recorded activity, and
                // saying otherwise is a promise the automation cannot keep.
                body = body + "<p style='margin:16px 0 0;padding-top:12px;border-top:1px solid #e5e5e5;color:#666666;font-size:13px;'>";
                body = body + "Days 2 and 3 arrive whether or not you have already followed up, so ignore this if you have been in touch. ";
                body = body + "Day 4 only arrives when nothing at all has been recorded against the deal, and Nathan is copied on it. ";
                body = body + "The check reads only what is in CRM, so a conversation you have not logged looks the same as no contact at all.";
                body = body + "</p>";
            }

            if(undatedList.size() > 0)
            {
                body = body + "<p style='margin:20px 0 8px;'><b>These proposals have no proposal date, so they cannot be tracked.</b> Please add the date and they will join the follow-up list.</p>";
                body = body + "<ul style='margin:0 0 8px;padding-left:20px;'>";
                for each line in undatedList
                {
                    body = body + line;
                }
                body = body + "</ul>";
            }

            if(escalating)
            {
                body = body + "<p style='margin:16px 0 0;color:#c8102e;'>Nathan is copied, because a proposal has gone four business days with nothing recorded.</p>";
            }

            body = body + "</div>";

            subject = "Proposal follow-ups today";
            if(dueList.size() == 0)
            {
                subject = "Proposals missing a proposal date";
            }
            if(escalating)
            {
                subject = "Action required: proposal follow-up";
            }

            if(SEND_EMAILS)
            {
                if(escalating)
                {
                    // The address fields are checked when the script is
                    // saved, so they cannot be variables. zoho.loginuserid is
                    // the schedule's owner and needs no separate verification.
                    // TO CHANGE WHO IS COPIED ON ESCALATIONS, edit the literal
                    // on the cc line here.
                    sendmail
                    [
                        from: zoho.loginuserid
                        to: addr
                        cc: "nathan.butcher@cprgroup.com.au"
                        subject: subject
                        message: body
                    ];
                }
                else
                {
                    sendmail
                    [
                        from: zoho.loginuserid
                        to: addr
                        subject: subject
                        message: body
                    ];
                }
                sentCount = sentCount + 1;
            }
            else
            {
                info "WOULD SEND to " + addr + " | subject: " + subject + " | " + body;
            }
        }
    }

    summary = "Examined " + examined + " deals at Formal Quote Sent. Skipped " + skipped + ". Digests sent: " + sentCount + ".";
    if(SEND_EMAILS == false)
    {
        summary = summary + " SEND_EMAILS is false, so nothing was emailed.";
    }
    // The schedule category returns void, so this line is the whole record of
    // the run. Read it at Setup -> Automation -> Schedules -> the schedule ->
    // Execution History.
    info summary;
}
